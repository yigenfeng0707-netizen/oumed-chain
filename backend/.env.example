# ============================================================
# 数据库配置
# ============================================================
# 开发环境用 SQLite；生产环境用 PostgreSQL（见 docker-compose.yml）
DATABASE_URL=sqlite+aiosqlite:///./yibao.db
# DATABASE_URL=postgresql+asyncpg://yibao:your-password@localhost:5432/yibao

# Redis配置（缓存/会话）
REDIS_URL=redis://localhost:6379

# ============================================================
# LLM 配置（三级降级：主力 → DashScope → 规则引擎）
# ============================================================
# 主力 LLM：aiping 网关（Kimi-K3，OpenAI 兼容）
LLM_API_KEY=your-aiping-api-key
LLM_BASE_URL=https://aiping.cn/api/v1
LLM_MODEL=Kimi-K3

# 备选 LLM：阿里云 DashScope（通义千问）
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
# 阿里云多模态视觉模型（档案管家转录上传的 CT/MRI 报告图片）
DASHSCOPE_VL_MODEL=qwen-vl-plus

# ============================================================
# 视觉模型配置（可选，医学影像自然语言解读）
# ============================================================
# 未配置 Key 时影像解读功能自动关闭，不影响主流程
VISION_API_KEY=your-aiping-api-key
VISION_BASE_URL=https://aiping.cn/api/v1
VISION_MODEL=GLM-4.6V

# ============================================================
# 向量库配置
# ============================================================
CHROMA_PERSIST_DIR=./chroma_data

# ============================================================
# OCR 服务（OCR.space）
# ============================================================
OCR_API_KEY=your-ocr-space-api-key
OCR_API_URL=https://api.ocr.space/parse/image

# ============================================================
# 安全配置（生产环境必填）
# ============================================================
# 身份作用域开关（P0 鉴权）：
#   true（默认）= 演示模式，业务端点信任 user_id 路径参数（user-switcher 零摩擦）
#   false = 生产模式，业务端点强制 X-User-Token 与 user_id 匹配（管理员可代查）
DEMO_MODE=true

# 管理后台超级管理员账号（生产环境必须修改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-this-admin-password
# 管理员 token 签发密钥（改后所有已签发 token 失效）
YIBAO_ADMIN_SECRET=please-change-this-admin-secret

# API 鉴权 Key（不配置则进入 Demo 开放模式；生产环境必须配置）
YIBAO_API_KEY=your-secure-api-key-here

# 会话 Token 加密盐值（生产环境必须替换为随机字符串）
YIBAO_SESSION_SECRET=please-change-this-to-a-random-secret

# CORS 允许的源（逗号分隔；生产环境必须收敛为具体域名）
# 示例：CORS_ORIGINS=https://yibao.example.com,https://www.yibao.example.com
CORS_ORIGINS=*

# ============================================================
# EEG 设备配置（可选，真实设备接入时使用）
# ============================================================
# EEG_DEVICE_TYPE=muse_lsl
# EEG_LSL_STREAM_NAME=auto
# EEG_LSL_STREAM_TYPE=EEG
# EEG_ACQUIRE_SECONDS=4

# ============================================================
# 路演 / 大赛 Demo
# ============================================================
# 离线模式：跳过 LLM/知识库，全程关键词+mock（无网络依赖，现场演示推荐）
DEMO_OFFLINE=true

# DEAP 数据集目录（用于 validate_deap.py 真实验证，可选）
# DEAP_DIR=D:/data/DEAP
