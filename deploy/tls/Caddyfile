# 瓯医数链 TLS 终结极简模板（Caddy 自动签发/续期证书，默认 TLS 1.3）
#
# 用法：修改域名后 `caddy run --config Caddyfile`；证书自动申请（需 80/443 公网可达）。
# Caddy 默认即启用 TLS 1.3 与 HSTS 之外的现代基线；HSTS 由后端中间件下发（生产模式）。

yimao.example.cn {
    # TODO: 替换为实际域名；证书自动签发（Let's Encrypt/ZeroSSL）
    reverse_proxy 127.0.0.1:8000 {
        transport http {
            read_timeout 120s   # LLM 长对话请求
        }
    }
    request_body {
        max_size 20MB           # 影像/档案上传
    }
}
